# ============================================================
# Variáveis de ambiente — copie para .env e preencha
# O .env NÃO deve ser commitado.
# ============================================================

# --- Supabase (front-end) ---------------------------------
# Inlinadas no bundle em build-time pelo Vite.
# Na Vercel, estas 3 keys existem duas vezes: uma com valor de
# produção (env Production) e outra com valor de preview (env Preview).
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# --- Testes E2E (Playwright) ------------------------------
# Conexão direta ao Postgres usada por insertOrder/deleteOrder.
# ⚠️ Localmente aponte para o banco de PREVIEW, nunca produção.
# No CI vem do secret DATABASE_URL_PREVIEW.
DATABASE_URL=""

# URL alvo dos testes. No CI vem do deploy de preview.
BASE_URL="http://localhost:5173"
